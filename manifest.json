{
  "manifest_version": 3,
  "name": "Udemy Outline Course Assistant",
  "version": "3.0.1",
  "description": "Auto-fill Udemy course forms (Intended learners, Landing page, Course messages) from a document using a local Ollama or ChatGPT AI model. By Veloxa Labs.",
  "author": "Veloxa Labs",
  "permissions": ["storage", "scripting", "tabs", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "https://*.udemy.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://api.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ollama_origin", "enabled": true, "path": "rules.json" }
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Udemy Outline Course Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/*/manage/*",
        "https://*.udemy.com/course/*/manage/*",
        "https://*.udemy.com/instructor/*"
      ],
      "js": ["src/content/udemy-filler.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/vendor/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
